# ── Ollama (uruchomiona lokalnie na hoście, port 11434) ───────────────────────
# Mac / Windows Docker Desktop: host.docker.internal działa natywnie
# Linux Docker Engine: wymaga extra_hosts: host-gateway (już skonfigurowane)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Model LLM – pełny model polski (~7 GB, wymaga min. 8 GB RAM)
LLM_MODEL=SpeakLeash/bielik-11b-v2.3-instruct:Q4_K_M
# Fallback dla słabszego sprzętu (~5 GB RAM):
# LLM_MODEL=llama3.1:8b
# Szybki i lekki (~2 GB RAM):
# LLM_MODEL=llama3.2:3b

# Model embeddingów (wielojęzyczny, dobry dla polskiego, ~274 MB)
EMBED_MODEL=nomic-embed-text

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=door_defects

# ── RAG ──────────────────────────────────────────────────────────────────────
TOP_K=5
TEMPERATURE=0.2
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
BACKEND_URL=http://backend:8080
